# Dot 设备（必填；多台设备用英文逗号分隔，每台都需添加图像 API 任务）
DOT_API_KEY=dot_app_your_api_key
DOT_DEVICE_IDS=DEVICE_ID_1,DEVICE_ID_2
DOT_BASE_URL=https://dot.mindreset.tech

# Claude 用量显示（可选，二选一）
# 方式1：Anthropic OAuth Token（推荐，macOS 可自动从 Keychain 发现，无需手动配置）
# ANTHROPIC_OAUTH_TOKEN=your_oauth_access_token
# 方式2：自定义 API 端点（兼容 sub2api 等）
# CLAUDE_USAGE_API_URL=https://your-api-url.com
# CLAUDE_USAGE_API_KEY=your_api_key
# CLAUDE_USAGE_ACCOUNT_IDS=all  # 自动汇总 active Anthropic 订阅账号，也可填 1,5

# Codex 用量显示（可选，默认从 PATH、ChatGPT.app 或 Codex.app 自动发现）
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
# CODEX_USAGE_CACHE_TTL_MS=600000  # 毫秒，默认 10 分钟

# Antigravity 用量显示（可选，默认 passive 模式：仅读本地缓存，不随 cron 后台轮询，避免风控风险）
# 推荐配合 Antigravity Stop Hook (`--agy-hook`) 或 CLI statusLine (`--agy-statusline`) 按真实使用事件刷新
# AGY_USAGE_MODE=passive           # 默认 passive（安全）；显式改为 poll 才允许定时主动调用 agy CLI
# AGY_BIN=~/.local/bin/agy         # 默认从 PATH、~/.local/bin/agy 或 Homebrew 自动发现
# AGY_QUOTA_GROUP=gemini           # 默认 gemini（gemini-5h / gemini-weekly），可选 3p
# AGY_USAGE_CACHE_TTL_MS=600000    # Hook 刷新冷却 / 缓存有效期（毫秒，默认 10 分钟）
# AGY_CLI_TIMEOUT_MS=30000         # 毫秒，默认 30 秒

TZ=Asia/Shanghai
